{#
    Template riêng cho trang "Website đang bảo trì".
    Không extends partials/base.html.twig -> không có header/nav/footer,
    dùng cho Maintenance plugin (maintenance_page_route) hoặc gắn link trực tiếp.
#}
<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: 'vi' }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ page.title }} | {{ config.site.title }}</title>
    <link rel="stylesheet" href="{{ url('theme://css/site.css') }}">
</head>
<body class="template-{{ page.template }}">
    <main class="maintenance-page">
        <div class="maintenance-box">
            <div class="maintenance-box__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <h1 class="maintenance-box__title">{{ page.title }}</h1>
            <div class="maintenance-box__desc">
                {{ page.content|raw }}
            </div>
        </div>
    </main>
</body>
</html>
