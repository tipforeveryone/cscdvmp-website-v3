{% extends 'partials/base.html.twig' %}

{% block content %}
    <main class="coming-soon-page">
        <div class="coming-soon">
            <div class="coming-soon__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h1 class="coming-soon__title">{{ page.title }}</h1>
            <p class="coming-soon__desc">{{ page.header.description }}</p>
            <a href="{{ page.header.back_url ?: (base_url ?: '/') }}" class="coming-soon__btn">{{ page.header.back_label }}</a>
        </div>
    </main>
{% endblock %}
