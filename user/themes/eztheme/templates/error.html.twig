{% extends 'partials/base.html.twig' %}

{% set is_english = uri.path starts with '/en' %}
{% set lang_prefix = is_english ? '/en' : '/vi' %}
{% set code = page.header.http_response_code ?: 404 %}

{% block title %}{{ code }} | {{ config.site.title }}{% endblock %}

{% block content %}
<main>
    <section class="cscd-section cscd-error">
        <div class="cscd-grid-overlay" aria-hidden="true"></div>
        <div class="cscd-vignette" aria-hidden="true"></div>

        <div class="container cscd-error__content">
            <div class="cscd-brackets" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

            <div class="cscd-eyebrow">
                <span class="cscd-eyebrow__dot" aria-hidden="true"></span>
                Error {{ code }}
            </div>

            <h1 class="cscd-error__code">{{ code }}</h1>

            <h2 class="cscd-heading cscd-heading--accent">
                {% if code == 404 %}
                    Page Not Found
                {% elseif code == 403 %}
                    Access Denied
                {% elseif code == 500 %}
                    Internal Server Error
                {% else %}
                    Something Went Wrong
                {% endif %}
            </h2>
            <div class="cscd-rule cscd-rule--center" aria-hidden="true"></div>

            <p class="cscd-text-muted cscd-error__text">
                {% if code == 404 %}
                    The page you're looking for doesn't exist. It may have been moved, renamed, or the link you followed is outdated.
                {% elseif code == 403 %}
                    You don't have permission to access this page.
                {% elseif code == 500 %}
                    Something went wrong on our end. Please try again in a moment.
                {% else %}
                    An unexpected error occurred. Please try again.
                {% endif %}
            </p>

            <div class="cscd-error__buttons">
                <a href="{{ lang_prefix }}" class="cscd-btn cscd-btn--primary"><span>Back to Home</span></a>
                <a href="{{ lang_prefix }}/wiki" class="cscd-btn cscd-btn--ghost"><span>Visit Wiki</span></a>
            </div>
        </div>
    </section>
</main>
{% endblock %}
