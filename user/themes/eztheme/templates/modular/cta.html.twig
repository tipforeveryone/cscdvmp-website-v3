{# Lời kêu gọi cuối trang: nền ảnh sáng hơn một chút + khung góc ngắm để "đóng" trang #}
<section class="cscd-section cscd-cta"{% if page.header.background_image %} style="--cscd-bg: url('{{ url('theme://images/cscd/' ~ page.header.background_image) }}')"{% endif %}>
    <div class="cscd-bg" aria-hidden="true"></div>
    <div class="cscd-vignette" aria-hidden="true"></div>

    <div class="container cscd-cta__content">
        <div class="cscd-brackets" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        {% if page.header.title %}
        <h2 class="cscd-heading">{{ page.header.title }}</h2>
        <div class="cscd-rule cscd-rule--center" aria-hidden="true"></div>
        {% endif %}
        {% if page.header.text %}<p class="cscd-text-muted cscd-cta__text">{{ page.header.text }}</p>{% endif %}
        {% if page.header.buttons %}
        <div class="cscd-cta__buttons">
            {% for btn in page.header.buttons %}
            <a href="{{ btn.url }}" class="cscd-btn{{ loop.index == 1 ? ' cscd-btn--primary' : ' cscd-btn--ghost' }}"><span>{{ btn.label }}</span></a>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>
