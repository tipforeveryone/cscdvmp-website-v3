{%- else -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18"/></svg>
{%- endif -%}
{% endmacro %}
{% import _self as plat %}

{% set current_lang = smls_current_language(page) %}
{# Danh sách kênh cộng đồng lấy từ các page 'block-content' có custom_position == 'social-links' #}
{% set bc_root = page.find(smls_root_path(current_lang) ~ '/block-content') %}
<section class="cscd-section cscd-social"{% if page.header.background_image %} style="--cscd-bg: url('{{ url('theme://images/cscd/' ~ page.header.background_image) }}')"{% endif %}>
    <div class="cscd-bg cscd-bg--deep" aria-hidden="true"></div>
    <div class="cscd-grid-overlay" aria-hidden="true"></div>

    <div class="container cscd-social__content">
        <h2 class="cscd-social__title">{{ page.title }}</h2>
        <div class="cscd-rule cscd-rule--center" aria-hidden="true"></div>

        {% if bc_root %}
        <div class="cscd-social__links">
            {% for link in bc_root.children.published.order('folder') %}
                {% if link.header.custom_position == 'social-links' %}
                <a href="{{ link.header.link_url }}" class="cscd-channel" target="_blank" rel="noopener">
                    <span class="cscd-channel__icon">{{ plat.platform_icon(link.header.link_url) }}</span>
                    <span class="cscd-channel__name">{{ link.title }}</span>
                    <span class="cscd-channel__arrow" aria-hidden="true"></span>
                </a>
                {% endif %}
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>
