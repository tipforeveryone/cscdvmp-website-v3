<!DOCTYPE html>
<html lang="{{ smls_current_language(page) ?: smls_default_language() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ page.summary ?: config.site.description }}">
    <title>{% block title %}{{ page.title }} | {{ config.site.title }}{% endblock %}</title>

    {% set is_english_favicon = uri.path starts with '/en' %}
    {% set nav_data = page.find(is_english_favicon ? '/en/nav' : '/vi/nav') %}
    {% if nav_data.header.logo %}
    <link rel="icon" type="image/png" href="{{ nav_data.header.logo }}">
    {% endif %}

    {% block stylesheets %}
        {# Oswald = tiêu đề quân sự (condensed, in hoa), Barlow = nội dung.
           Cả hai đều có subset "vietnamese" nên dấu tiếng Việt hiển thị đúng. #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap">
        <link rel="stylesheet" href="{{ url('theme://css/site.css') }}">
    {% endblock %}
    
    {% block extra_head %}{% endblock %}
</head>
<body class="template-{{ page.template }}">
    {% include 'partials/header.html.twig' %}
    
    {% block content %}{% endblock %}
    
    {% include 'partials/footer.html.twig' %}

    {% block javascripts %}
        <script src="{{ url('theme://js/site.js') }}"></script>
    {% endblock %}
</body>
</html>
