{% set is_english = uri.path starts with '/en' %}
{% set footer = page.find(is_english ? '/en/footer' : '/vi/footer') %}
{# Nội dung 4 cột lấy từ page 'block-content' có custom_position == 'footer-*' #}
{% set bc_root = pages.find(is_english ? '/en/block-content' : '/vi/block-content') %}

<footer>
    <div class="container">
        <div class="footer-content">

            {# Cột 0: Logo công ty #}
            {% if bc_root %}
            {% for block in bc_root.children.published.order('folder') %}
                {% if block.header.custom_position == 'footer-logo' %}
                <div class="footer-col footer-col--logo ipeb-editable">
                    {{ pml_edit_button(block) }}
                    {{ block.content|raw }}
                </div>
                {% endif %}
            {% endfor %}

            {# Cột 1: Địa chỉ văn phòng + liên hệ #}
            {% for block in bc_root.children.published.order('folder') %}
                {% if block.header.custom_position == 'footer-contact' %}
                <div class="footer-col footer-office ipeb-editable">
                    {{ pml_edit_button(block) }}
                    {{ block.content|raw }}
                </div>
                {% endif %}
            {% endfor %}

            {# Cột 2: Disclaimer #}
            {% for block in bc_root.children.published.order('folder') %}
                {% if block.header.custom_position == 'footer-disclaimer' %}
                <div class="footer-col footer-disclaimer ipeb-editable">
                    {{ pml_edit_button(block) }}
                    {{ block.content|raw }}
                </div>
                {% endif %}
            {% endfor %}
            {% endif %}

        </div>

        <div class="footer-bottom">
            {% if bc_root %}
            {% for block in bc_root.children.published.order('folder') %}
                {% if block.header.custom_position == 'footer-copyright' %}
                <p class="ipeb-editable">
                    {{ pml_edit_button(block) }}
                    &copy; {{ now|date('Y') }} {{ block.content|raw|striptags }}
                </p>
                {% endif %}
            {% endfor %}
            {% endif %}
            {% if tip_visitor_gadget_available and footer.header.pageviews_label and footer.header.visitors_label %}
            {{ tip_visitor_gadget(footer.header.pageviews_label, footer.header.visitors_label) }}
            {% endif %}
        </div>
    </div>
</footer>
