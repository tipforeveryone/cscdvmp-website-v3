<!-- Hero Slider -->
<div class="hero-slider" id="heroSlider">
    <!-- Slides Container -->
    <div class="slider-container">
        <div class="slider-track" id="sliderTrack">
            <!-- Slide 1 -->
            <div class="slide">
                <img src="{{ url('theme://images/slider-1.jpg') }}" alt="Banner 1" class="slide-image">
            </div>

            <!-- Slide 2 -->
            <div class="slide">
                <img src="{{ url('theme://images/slider-2.jpg') }}" alt="Banner 2" class="slide-image">
            </div>

            <!-- Slide 3 -->
            <div class="slide">
                <img src="{{ url('theme://images/slider-3.jpg') }}" alt="Banner 3" class="slide-image">
            </div>
        </div>
    </div>
    
    <!-- Previous Button -->
    <button class="slider-btn slider-btn-prev" id="sliderPrev" aria-label="Slide trước">
        <span>&#10094;</span>
    </button>
    
    <!-- Next Button -->
    <button class="slider-btn slider-btn-next" id="sliderNext" aria-label="Slide tiếp">
        <span>&#10095;</span>
    </button>
    
    <!-- Paging Dots -->
    <div class="slider-paging" id="sliderPaging">
        <button class="paging-dot active" data-slide="0" aria-label="Slide 1"></button>
        <button class="paging-dot" data-slide="1" aria-label="Slide 2"></button>
        <button class="paging-dot" data-slide="2" aria-label="Slide 3"></button>
    </div>
</div>
